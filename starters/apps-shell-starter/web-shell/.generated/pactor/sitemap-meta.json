{
  "layout": "admin",
  "dslVersion": "1.0",
  "app": {
    "name": "InnoSpots"
  },
  "auth": {
    "loginPath": "/login"
  },
  "layouts": {
    "admin": {
      "dsl": "1.0",
      "body": {
        "type": "Layout",
        "props": {
          "className": "shell-root"
        },
        "children": [
          {
            "type": "NavigationShell",
            "props": {
              "menus": "${data.session.menus}",
              "railFooter": {
                "type": "UserMenu",
                "props": {
                  "user": {
                    "name": "${data.session.user.name || '访客'}",
                    "email": "${data.session.user.username || ''}"
                  },
                  "items": [
                    {
                      "label": "个人中心",
                      "value": "/profile",
                      "icon": "user-round"
                    }
                  ],
                  "showName": false,
                  "side": "right",
                  "align": "end"
                },
                "events": {
                  "onSelect": [
                    {
                      "action": "navigate",
                      "params": {
                        "to": "${event}"
                      }
                    }
                  ],
                  "onSignOut": [
                    {
                      "action": "request",
                      "params": {
                        "method": "POST",
                        "url": "/api/auth/logout"
                      }
                    },
                    {
                      "action": "app.reload",
                      "params": {
                        "to": "/login"
                      }
                    }
                  ]
                }
              }
            },
            "children": [
              {
                "type": "Content",
                "props": {
                  "className": "shell-content"
                },
                "children": [
                  {
                    "type": "PageOutlet"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "login": {
      "dsl": "1.0",
      "body": {
        "type": "PageOutlet"
      }
    },
    "auth": {
      "dsl": "1.0",
      "body": {
        "type": "Flex",
        "props": {
          "direction": "vertical",
          "justify": "center",
          "align": "center",
          "style": {
            "minHeight": "100vh",
            "padding": 24
          }
        },
        "children": [
          {
            "type": "Flex",
            "props": {
              "direction": "vertical",
              "style": {
                "width": 380,
                "padding": 24,
                "border": "1px solid var(--border)",
                "borderRadius": 12
              }
            },
            "children": [
              {
                "type": "PageOutlet"
              }
            ]
          }
        ]
      }
    },
    "blank": {
      "dsl": "1.0",
      "body": {
        "type": "PageOutlet"
      }
    }
  }
}
