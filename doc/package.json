{
  "name": "pactor-asset-library",
  "version": "0.1.0",
  "private": true,
  "description": "Pactor UI 资产库（样式/组件/主题/模板/素材）",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4336",
    "start": "astro dev --port 4336",
    "build": "pnpm validate && pnpm build:info && astro build",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "validate": "node --experimental-strip-types scripts/validate.ts",
    "build:info": "node --experimental-strip-types scripts/build-info.ts",
    "gen:theme-scales": "node --experimental-strip-types scripts/gen-theme-scales.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@pactor-app/core": "workspace:*",
    "@pactor-app/runtime": "workspace:*",
    "@pactor-app/ui": "workspace:*",
    "astro": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "culori": "^4.0.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.121.0",
    "yaml": "^2.9.0"
  }
}
