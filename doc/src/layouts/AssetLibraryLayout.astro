---
/**
 * 资产库三栏布局壳（design D5）：58px 顶栏 + 左导航 / 中内容 / 右看板。
 * 中间区独立滚动；<1024px 左右栏收起为抽屉（少量 vanilla JS 控制开合）。
 * 站点页脚（SiteFooter 区块组件）位于 main 内随内容滚动，
 * 底部栏展示构建期注入的真实构建版本 / 最近同步时间 / Git 提交号。
 */
import '@pactor-app/ui/styles.css';
import '@pactor-app/chart/styles.css';
import '@pactor-app/blocks/styles.css';
import '../styles/asset-library.css';
import TopNav from '../components/TopNav.astro';
import SideNav from '../components/SideNav.astro';
import Inspector from '../components/Inspector.tsx';
import DslPreview from '../components/previews/DslPreview';
import { DOCS_SITE_URL, SITE_NAME } from '../config';
import buildInfo from '../generated/build-info.json';
import type { AssetCategory } from '../assets-data/types';

interface Props {
  title: string;
  description?: string;
  category: AssetCategory;
  currentPath: string;
  /** 右侧看板默认态的页面目录（页内锚点） */
  headings?: { id: string; text: string }[];
  /** 右侧看板默认态的元信息键值 */
  meta?: { label: string; value: string }[];
  /** 右侧看板默认态「使用说明」文案（缺省为对象检查模式说明） */
  usage?: string;
}

const {
  title,
  description,
  category,
  currentPath,
  headings = [],
  meta = [],
  usage,
} = Astro.props;

function formatBuiltAt(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  const pad = (n: number) => String(n).padStart(2, '0');
  return (
    `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())} ` +
    `${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())} UTC`
  );
}

const builtAtText = formatBuiltAt(buildInfo.builtAt);

/** 站点页脚 DSL（SiteFooter 业务组件）：品牌区 + 资产/资源链接列 + 底部构建信息 */
const siteFooterNode = {
  type: 'SiteFooter',
  props: {
    brand: {
      name: SITE_NAME,
      description:
        'Pactor 动态应用运行时 —— 组件 / 主题 / 模板 / 素材的规范化资产管理平台。',
    },
    groups: [
      {
        title: '资产',
        links: [
          { text: '组件', href: '/components' },
          { text: '主题', href: '/themes' },
          { text: '模板', href: '/templates' },
          { text: '素材', href: '/materials' },
        ],
      },
      {
        title: '资源',
        links: [
          { text: '使用文档', href: DOCS_SITE_URL },
          { text: '样式规范', href: '/styles/overview' },
        ],
      },
    ],
    copyright: `© 2026 ${SITE_NAME} · 当前构建版本 ${buildInfo.version} · 最近同步 ${builtAtText} · Git commit ${buildInfo.commit}`,
  },
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title} · {SITE_NAME}</title>
    <script is:inline>
      // 深色模式初始化（首绘前执行避免闪烁）：localStorage 优先，缺省跟随系统；
      // data-theme 驱动站点样式，data-pactor-theme 驱动 @pactor-app/ui 组件令牌
      (function () {
        var t = localStorage.getItem('doc-theme');
        if (t !== 'dark' && t !== 'light') {
          t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        var el = document.documentElement;
        el.dataset.theme = t;
        el.dataset.pactorTheme = t;
      })();
    </script>
  </head>
  <body>
    <TopNav />
    <div class="shell">
      <SideNav category={category} currentPath={currentPath} />
      <main class="main" id="main">
        <div class="content">
          <slot />
        </div>
        <div class="site-footer">
          <DslPreview client:only="react" node={siteFooterNode} />
        </div>
      </main>
      <aside class="inspector" id="inspector">
        <Inspector client:load headings={headings} meta={meta} usage={usage} />
      </aside>
    </div>
    <div class="drawer-overlay" id="drawerOverlay"></div>
    <script>
      // 小屏抽屉开合（<1024px）：顶栏「目录 / 看板」按钮、遮罩、Esc、岛内的收起按钮
      const sidebar = document.getElementById('sidebar');
      const inspector = document.getElementById('inspector');
      const overlay = document.getElementById('drawerOverlay');

      const anyOpen = () =>
        Boolean(
          sidebar?.classList.contains('open') ||
            inspector?.classList.contains('open'),
        );
      const syncOverlay = () => overlay?.classList.toggle('show', anyOpen());
      const closeDrawers = () => {
        sidebar?.classList.remove('open');
        inspector?.classList.remove('open');
        syncOverlay();
      };

      document.querySelectorAll('[data-drawer-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const target =
            btn.getAttribute('data-drawer-toggle') === 'left'
              ? sidebar
              : inspector;
          const other = target === sidebar ? inspector : sidebar;
          other?.classList.remove('open');
          target?.classList.toggle('open');
          syncOverlay();
        });
      });
      overlay?.addEventListener('click', closeDrawers);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeDrawers();
      });
      document.addEventListener('assetlib:close-drawer', closeDrawers);

      // 左侧导航滚动位置保持（详情浏览往返后不丢失）
      const SCROLL_KEY = 'assetlib:sidebar-scroll';
      const sideMenu = document.getElementById('sidebar');
      const saved = Number(sessionStorage.getItem(SCROLL_KEY) ?? '0');
      if (sideMenu && saved > 0) sideMenu.scrollTop = saved;
      sideMenu?.addEventListener(
        'scroll',
        () => {
          sessionStorage.setItem(SCROLL_KEY, String(sideMenu.scrollTop));
        },
        { passive: true },
      );
    </script>
  </body>
</html>
