---
/**
 * 资产集合页模板（spec：资产集合页）。
 * 渲染：标题说明、使用规则区、筛选条（FilterBar 岛，URL query 双向同步）、
 * 结果数量、卡片网格（名称 + 描述 + StatusBadges + data-inspect）。
 * 无 JS 时 FilterBar 不水合，完整列表直出可见（渐进增强，D7）；
 * 失效外链条目禁用跳转并给出说明。
 */
import AssetLibraryLayout from '../layouts/AssetLibraryLayout.astro';
import StatusBadges from '../components/StatusBadges.astro';
import FilterBar from '../components/FilterBar';
import { findCategory } from '../site-nav';
import { renderMarkdown } from '../lib/markdown';
import { toInspectAttrs } from '../lib/inspect';
import type {
  AssetCategory,
  ChangeFlag,
  Integration,
  LinkAvailability,
  Maturity,
} from '../assets-data/types';

export interface CollectionFilterOption {
  value: string;
  label: string;
}

export interface CollectionFilter {
  /** URL query 参数名（如 type / maturity） */
  key: string;
  label: string;
  options: CollectionFilterOption[];
}

export type BadgeKind = 'success' | 'warning' | 'info' | 'danger';

export interface CollectionItem {
  id: string;
  name: string;
  description: string;
  href: string;
  maturity: Maturity;
  change?: ChangeFlag;
  integration?: Integration;
  /** 外链可用性（外部资源条目）；broken 时卡片禁用跳转 */
  availability?: LinkAvailability;
  /** 各筛选维度取值，key 对应 filters[].key */
  filters?: Record<string, string>;
  /** 最近更新（ISO 日期），供排序「最近更新」使用 */
  updatedAt?: string;
  /** 附加徽章（如板块标签） */
  extraBadges?: { text: string; kind: BadgeKind }[];
}

interface Props {
  title: string;
  description?: string;
  category: AssetCategory;
  currentPath: string;
  filters?: CollectionFilter[];
  items: CollectionItem[];
  /** 使用规则（markdown 子集字符串） */
  guidance?: string;
}

const {
  title,
  description,
  category,
  currentPath,
  filters = [],
  items,
  guidance,
} = Astro.props;
const cat = findCategory(category)!;

const headings = [
  ...(guidance ? [{ id: 'sec-guidance', text: '使用规则' }] : []),
  { id: 'sec-items', text: '全部条目' },
];

const meta = [
  { label: '分类', value: cat.label },
  { label: '板块', value: title },
  { label: '条目数', value: `${items.length}` },
  { label: '路由', value: currentPath },
];

/** 预计算卡片的检查属性与筛选 data 属性（SSR 直出，岛按 data 属性过滤） */
const prepared = items.map((item) => {
  const broken = item.availability === 'broken';
  const dataAttrs: Record<string, string> = {
    'data-filter-item': '',
    'data-search': `${item.name} ${item.description}`.toLowerCase(),
    ...(item.updatedAt ? { 'data-updated': item.updatedAt } : {}),
    ...Object.fromEntries(
      Object.entries(item.filters ?? {}).map(([k, v]) => [`data-filter-${k}`, v]),
    ),
  };
  const inspectAttrs = toInspectAttrs({
    id: item.id,
    name: item.name,
    type: '资产条目',
    maturity: item.maturity,
    change: item.change,
    integration: item.integration,
    props: item.filters,
    description: item.description,
  });
  return { ...item, broken, dataAttrs, inspectAttrs };
});
---

<AssetLibraryLayout
  title={title}
  description={description}
  category={category}
  currentPath={currentPath}
  headings={headings}
  meta={meta}
>
  <div class="breadcrumb">资产库 / {cat.label} / {title}</div>
  <div class="page-head">
    <div class="page-head-main">
      <h1>{title}</h1>
      {description && <div class="page-desc">{description}</div>}
    </div>
  </div>

  {
    guidance && (
      <section class="section" id="sec-guidance">
        <h2 class="section-title">使用规则</h2>
        <div class="note-md" set:html={renderMarkdown(guidance)} />
      </section>
    )
  }

  <section class="section" id="sec-items">
    <h2 class="section-title">全部条目</h2>
    <div class="collection">
      <FilterBar client:load filters={filters} />
      <p class="result-count" data-filter-count aria-live="polite">
        共 {items.length} 条
      </p>
      <div class="grid">
        {
          prepared.map((item) => {
            const body = (
              <div class="card-body">
                <div class="card-title">{item.name}</div>
                <div class="card-desc">{item.description}</div>
                <StatusBadges
                  maturity={item.maturity}
                  change={item.change}
                  integration={item.integration}
                  availability={item.availability}
                />
                {item.extraBadges && item.extraBadges.length > 0 && (
                  <div class="badges">
                    {item.extraBadges.map((b) => (
                      <span class={`badge ${b.kind}`}>{b.text}</span>
                    ))}
                  </div>
                )}
                {item.broken && (
                  <div class="card-desc">外链已失效，暂不可跳转。</div>
                )}
              </div>
            );
            return item.broken ? (
              <div class="card is-disabled" {...item.dataAttrs} {...item.inspectAttrs}>
                {body}
              </div>
            ) : (
              <a class="card link-card" href={item.href} {...item.dataAttrs} {...item.inspectAttrs}>
                {body}
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</AssetLibraryLayout>
