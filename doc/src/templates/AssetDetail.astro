---
/**
 * 资产详情页模板（spec：资产详情页）。
 * 渲染：面包屑、标题 + 三轨状态徽章（StatusBadges 头部）、固定章节顺序、
 * 右看板元信息、关联资产区。章节 notApplicable 时渲染「不适用：原因」，
 * 不静默省略；卡片/列表对象可继续用 data-inspect（经 toInspectAttrs）。
 */
import AssetLibraryLayout from '../layouts/AssetLibraryLayout.astro';
import StatusBadges from '../components/StatusBadges.astro';
import { findCategory } from '../site-nav';
import { renderMarkdown } from '../lib/markdown';
import { toInspectAttrs, type InspectEntry } from '../lib/inspect';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type {
  AssetCategory,
  ChangeFlag,
  Integration,
  LinkAvailability,
  Maturity,
} from '../assets-data/types';

export interface AssetDetailSection {
  title: string;
  /** 章节内容：Astro 片段组件或 markdown 字符串；与 notApplicable 互斥 */
  body?: string | AstroComponentFactory;
  /** body 为片段组件时透传的 props */
  bodyProps?: Record<string, unknown>;
  /** 不适用的原因；给出时渲染「不适用：原因」 */
  notApplicable?: string;
}

export interface AssetDetailStatus {
  maturity: Maturity;
  change?: ChangeFlag;
  integration?: Integration;
  availability?: LinkAvailability;
}

export interface AssetDetailRelated {
  id: string;
  name: string;
  href: string;
  maturity?: Maturity;
  note?: string;
}

interface Props {
  title: string;
  description?: string;
  category: AssetCategory;
  currentPath: string;
  /** 上级板块（面包屑）；如 通用组件 → /components/general */
  parent?: { name: string; href: string };
  status: AssetDetailStatus;
  /** 章节按数组顺序固定渲染 */
  sections: AssetDetailSection[];
  /** 右看板默认态元信息 */
  meta?: { label: string; value: string }[];
  related?: AssetDetailRelated[];
  /** 页面主体资产本身（传入后页头可被右看板检查） */
  inspect?: InspectEntry;
}

const {
  title,
  description,
  category,
  currentPath,
  parent,
  status,
  sections,
  meta = [],
  related = [],
  inspect,
} = Astro.props;
const cat = findCategory(category)!;

const headings = sections.map((s, i) => ({
  id: `sec-${i}`,
  text: s.title,
}));

/** 片段组件提升为可渲染变量（markdown 字符串走 note-md 渲染） */
const preparedSections = sections.map((s, i) => ({
  ...s,
  anchor: `sec-${i}`,
  FragmentBody: typeof s.body === 'function' ? s.body : null,
}));
---

<AssetLibraryLayout
  title={title}
  description={description}
  category={category}
  currentPath={currentPath}
  headings={headings}
  meta={meta}
>
  <div class="breadcrumb">
    资产库 / <a href={`/${cat.routePrefix}/overview`}>{cat.label}</a>
    {parent && <> / <a href={parent.href}>{parent.name}</a></>} / {title}
  </div>
  <div class="page-head">
    <div class="page-head-main" {...(inspect ? toInspectAttrs(inspect) : {})}>
      <h1>{title}</h1>
      {description && <div class="page-desc">{description}</div>}
      <StatusBadges
        maturity={status.maturity}
        change={status.change}
        integration={status.integration}
        availability={status.availability}
      />
    </div>
  </div>

  {
    preparedSections.map((s) => (
      <section class="section" id={s.anchor}>
        <h2 class="section-title">{s.title}</h2>
        {s.notApplicable !== undefined ? (
          <div class="na-box">
            <b>不适用：</b>
            {s.notApplicable}
          </div>
        ) : s.FragmentBody ? (
          <s.FragmentBody {...(s.bodyProps ?? {})} />
        ) : typeof s.body === 'string' ? (
          <div class="note-md" set:html={renderMarkdown(s.body)} />
        ) : null}
      </section>
    ))
  }

  {
    related.length > 0 && (
      <section class="section" id="sec-related">
        <h2 class="section-title">关联资产</h2>
        <div class="card-grid">
          {related.map((r) => (
            <a
              class="card link-card"
              href={r.href}
              {...toInspectAttrs({
                id: r.id,
                name: r.name,
                type: '关联资产',
                maturity: r.maturity,
                description: r.note,
              })}
            >
              <div class="card-body">
                <div class="card-title">{r.name}</div>
                {r.note && <div class="card-desc">{r.note}</div>}
                <StatusBadges maturity={r.maturity} />
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }
</AssetLibraryLayout>
