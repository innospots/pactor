---
/**
 * 主题总览页自定义区（任务 4.6）：
 * 主题构成链路（静态五步，对应 ThemeEntry 数据字段）、16 色系入口卡片
 * （色块取该系已接入主题的 primary，构建期统计主题数）、
 * 暖 / 自然 / 冷 / 中性分组筛选（FilterBar，状态写 URL query）、
 * 主题生成器入口卡片（顶部导航同款「待设计」态）。
 */
import FilterBar from './FilterBar';
import { themes, themeFamilies } from '../assets-data/themes';
import { toInspectAttrs } from '../lib/inspect';
import type { ThemeFamilyId } from '../assets-data/types';

/** 色系分组（theme-design.md §2 分类体系） */
const FAMILY_GROUP: Record<ThemeFamilyId, { value: string; label: string }> = {
  zhusha: { value: 'warm', label: '暖色' },
  yanli: { value: 'warm', label: '暖色' },
  haitang: { value: 'warm', label: '暖色' },
  xiangye: { value: 'warm', label: '暖色' },
  zhizi: { value: 'warm', label: '暖色' },
  qiuxiang: { value: 'natural', label: '自然色' },
  zhuqing: { value: 'natural', label: '自然色' },
  songhua: { value: 'natural', label: '自然色' },
  tianqing: { value: 'cool', label: '冷色' },
  kongquelan: { value: 'cool', label: '冷色' },
  qunqing: { value: 'cool', label: '冷色' },
  dailan: { value: 'cool', label: '冷色' },
  tengluo: { value: 'cool', label: '冷色' },
  tanse: { value: 'neutral', label: '中性色' },
  yuebai: { value: 'neutral', label: '中性色' },
  xuanqing: { value: 'neutral', label: '中性色' },
};

/** 色系入口卡片数据（构建期统计） */
const families = themeFamilies.map((family) => {
  const familyId = family.id.slice('family.'.length) as ThemeFamilyId;
  const members = themes.filter((t) => t.familyId === familyId);
  const integrated = members.filter((t) => t.integration === 'integrated');
  const primary =
    integrated.find((t) => t.resolvedTokens?.primary)?.resolvedTokens?.primary ??
    integrated.find((t) => t.scale?.length)?.scale?.[4]?.hex ??
    '#e6eaf0';
  const group = FAMILY_GROUP[familyId];
  return {
    familyId,
    name: family.name,
    href: `/themes/${familyId}`,
    description: family.description,
    themeCount: members.length,
    integratedCount: integrated.length,
    primary,
    group,
  };
});

const totalThemes = themes.length;
const integratedThemes = themes.filter((t) => t.integration === 'integrated').length;
---

<section class="section" id="sec-pipeline">
  <h2 class="section-title">主题构成链路</h2>
  <p class="section-sub">
    一个主题由传统参考色出发，经校准与展开得到可复用的语义 Token，最终被组件页面消费；以下五步与主题数据的字段一一对应。
  </p>
  <div class="flow-steps">
    <div class="flow-step">
      <span class="no">步骤 1</span>
      <div class="t">传统参考色</div>
      <div class="d">传统色出处（traditionalColorRef）与色阶基准色 baseHex，来源为文档可查的传统色表。</div>
    </div>
    <div class="flow-step">
      <span class="no">步骤 2</span>
      <div class="t">UI 主色</div>
      <div class="d">校准后的界面主色（resolvedTokens.primary），是语义映射的核心锚点。</div>
    </div>
    <div class="flow-step">
      <span class="no">步骤 3</span>
      <div class="t">色阶</div>
      <div class="d">以 OKLCH 生成的 10 阶色阶（step 1-10），附 sRGB 回退与 HEX，保证跨屏一致。</div>
    </div>
    <div class="flow-step">
      <span class="no">步骤 4</span>
      <div class="t">语义 Token</div>
      <div class="d">background / primary / muted 等语义映射（resolvedTokens），对齐组件库的语义令牌。</div>
    </div>
    <div class="flow-step">
      <span class="no">步骤 5</span>
      <div class="t">组件页面</div>
      <div class="d">组件按语义 Token 取色渲染；组件 Token 映射随后续批次接入。</div>
    </div>
  </div>
</section>

<section class="section" id="sec-families">
  <h2 class="section-title">色系入口</h2>
  <p class="section-sub">
    共 {families.length} 个色系、{totalThemes} 个主题（已接入 {integratedThemes} 个，其余待资产接入）；色块为该系已接入主题的 UI 主色，主题数与接入数为构建期统计。
  </p>
  <div class="collection">
    <FilterBar
      client:load
      filters={[
        {
          key: 'group',
          label: '色系分组',
          options: [
            { value: 'warm', label: '暖色' },
            { value: 'natural', label: '自然色' },
            { value: 'cool', label: '冷色' },
            { value: 'neutral', label: '中性色' },
          ],
        },
      ]}
    />
    <p class="result-count" data-filter-count aria-live="polite">
      共 {families.length} 条
    </p>
    <div class="card-grid">
      {
        families.map((f) => (
          <a
            class="card link-card"
            href={f.href}
            data-filter-item
            data-search={`${f.name} ${f.description}`.toLowerCase()}
            data-filter-group={f.group.value}
            {...toInspectAttrs({
              id: `family.${f.familyId}`,
              name: `${f.name}色系`,
              type: '色系',
              maturity: 'experimental',
              integration: f.integratedCount > 0 ? 'integrated' : 'pending',
              props: {
                色系分组: f.group.label,
                主题数: `${f.themeCount}`,
                已接入: `${f.integratedCount}`,
              },
              description: f.description,
            })}
          >
            <div class="color-band" style={`background:${f.primary}`} />
            <div class="card-body">
              <div class="card-title">
                {f.name}
                <span class="badge info">{f.group.label}</span>
              </div>
              <div class="card-desc">{f.description}</div>
              <div class="badges">
                <span class="badge info">{f.themeCount} 个主题</span>
                {f.integratedCount < f.themeCount ? (
                  <span class="badge warning">
                    已接入 {f.integratedCount} · 待接入 {f.themeCount - f.integratedCount}
                  </span>
                ) : (
                  <span class="badge success">全部接入</span>
                )}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<section class="section" id="sec-generator">
  <h2 class="section-title">主题生成器</h2>
  <div class="card">
    <div class="card-body">
      <div class="card-title">
        主题生成器 <span class="badge warning">待设计</span>
      </div>
      <div class="card-desc">
        基于已有主题派生新主题变体（传入主题 ID 与覆盖项，输出差量配置）。
        当前状态与顶部导航一致：功能待设计，暂不可进入；上线后支持从任意主题详情页传入主题 ID 生成变体。
      </div>
    </div>
  </div>
</section>
