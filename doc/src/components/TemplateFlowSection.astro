---
/**
 * 线框模板章节正文流：按文档顺序渲染内容块——
 * 说明文字（markdown）、运行态预览（iframe 嵌入独立预览页
 * /templates/wireframe/preview/<slug>/<name>，加载落盘的提炼 DSL）、
 * 结构 Tab（```yaml 围栏块原位展示，与该布局预览同组）。
 * ASCII 线框围栏块已在加载器剔除，不在此处出现。
 */
import type { FlowBlock } from "../assets-data/wireframe-templates";
import TemplateStructureTabs from "./TemplateStructureTabs";

interface Props {
  slug: string;
  blocks: FlowBlock[];
}

const { slug, blocks } = Astro.props;
---

{
  blocks.map((b) => {
    if (b.kind === "html") {
      return <div class="note-md" set:html={b.html} />;
    }
    if (b.kind === "preview") {
      const frameHeight = b.preview.height ?? 560;
      return (
        <div class="tpl-preview">
          <div class="tpl-preview-bar">
            <span class="tpl-preview-title" />
            <a
              class="tpl-preview-open"
              href={`/templates/wireframe/preview/${slug}/${b.preview.name}`}
              target="_blank"
              rel="noreferrer"
            >
              新窗口打开 ↗
            </a>
          </div>
          <iframe
            class="tpl-preview-frame"
            style={`height: ${frameHeight}px; margin-bottom: ${-frameHeight * 0.2}px;`}
            src={`/templates/wireframe/preview/${slug}/${b.preview.name}`}
            loading="lazy"
            title={b.preview.title}
          />
        </div>
      );
    }
    return <TemplateStructureTabs block={b.block} client:visible />;
  })
}
