---
/**
 * 组件总览页自定义区（任务 4.3）：覆盖矩阵、常用组件、最近更新、实验区。
 * 所有计数与列表构建期从组件数据统计；「常用组件」为运营手工选择并注明。
 */
import StatusBadges from './StatusBadges.astro';
import ExceptionState from './ExceptionState.astro';
import { components } from '../assets-data/components';
import { SITE_NAV } from '../site-nav';
import { toInspectAttrs } from '../lib/inspect';
import type { ComponentEntry } from '../assets-data/types';

const componentNav = SITE_NAV.find((c) => c.id === 'components')!;

/** 按侧栏顺序统计各分类组件数（覆盖矩阵数据源） */
const matrix = componentNav.items
  .filter((i) => i.slug !== 'overview')
  .map((item) => ({
    slug: item.slug,
    name: item.name,
    count: components.filter((c) => c.category === item.slug).length,
  }));
const total = components.length;
const max = Math.max(...matrix.map((m) => m.count));

/** 常用组件：运营手工选择的 8 个代表（注明非数据统计） */
const COMMON_IDS = [
  'component.button',
  'component.input',
  'component.select',
  'component.modal',
  'component.table',
  'component.form',
  'component.chat-message',
  'component.dropdown',
];
const common = COMMON_IDS.map(
  (id) => components.find((c) => c.id === id)!,
).filter(Boolean);

/** 最近更新：本期新增或更新的组件 */
const recent = components.filter((c) => c.change === 'new' || c.change === 'updated');

/** 实验区：成熟度为实验的组件 */
const experimental = components.filter((c) => c.maturity === 'experimental');

const cardAttrs = (c: ComponentEntry) =>
  toInspectAttrs({
    id: c.id,
    name: c.name,
    type: '组件',
    maturity: c.maturity,
    change: c.change,
    integration: c.integration,
    props: { 分类: c.category, 用途: c.purpose },
    description: c.description,
  });
---

<section class="section" id="sec-matrix">
  <h2 class="section-title">覆盖矩阵</h2>
  <p class="section-sub">
    10 个二级分类合计 {total} 个组件，数量为构建期统计；点击行进入对应分类集合页。
  </p>
  <table class="data-table">
    <thead>
      <tr>
        <th>分类</th>
        <th>组件数</th>
        <th>占比</th>
        <th>分布</th>
      </tr>
    </thead>
    <tbody>
      {
        matrix.map((row) => (
          <tr {...toInspectAttrs({ id: `matrix.${row.slug}`, name: `${row.name}分类`, type: '覆盖矩阵行', props: { 分类: row.name, 组件数: `${row.count}` } })}>
            <td>
              <a href={`/components/${row.slug}`}>{row.name}</a>
            </td>
            <td class="num">{row.count}</td>
            <td class="num">{((row.count / total) * 100).toFixed(1)}%</td>
            <td>
              <div class="matrix-bar" aria-hidden="true">
                <i style={`width:${((row.count / max) * 100).toFixed(1)}%`} />
              </div>
            </td>
          </tr>
        ))
      }
      <tr>
        <td><b>合计</b></td>
        <td class="num"><b>{total}</b></td>
        <td class="num">100%</td>
        <td>—</td>
      </tr>
    </tbody>
  </table>
</section>

<section class="section" id="sec-common">
  <h2 class="section-title">常用组件</h2>
  <p class="section-sub">
    「常用」为运营选择的代表组件（非使用频次统计），用于快速进入高频组件详情。
  </p>
  <div class="grid">
    {
      common.map((c) => (
        <a
          class="card link-card"
          href={`/components/${c.category}/${c.id.slice('component.'.length)}`}
          {...cardAttrs(c)}
        >
          <div class="card-body">
            <div class="card-title">{c.name}</div>
            <div class="card-desc">{c.purpose}。</div>
            <StatusBadges maturity={c.maturity} change={c.change} />
          </div>
        </a>
      ))
    }
  </div>
</section>

<section class="section" id="sec-recent">
  <h2 class="section-title">最近更新</h2>
  <p class="section-sub">
    本期新增或更新的组件共 {recent.length} 个（首批评入，全部为本期新增）。
  </p>
  <div class="grid">
    {
      recent.map((c) => (
        <a
          class="card link-card"
          href={`/components/${c.category}/${c.id.slice('component.'.length)}`}
          {...cardAttrs(c)}
        >
          <div class="card-body">
            <div class="card-title">{c.name}</div>
            <div class="card-desc">{c.purpose}。</div>
            <StatusBadges maturity={c.maturity} change={c.change} />
          </div>
        </a>
      ))
    }
  </div>
</section>

<section class="section" id="sec-experimental">
  <h2 class="section-title">实验区</h2>
  {
    experimental.length > 0 ? (
      <div class="grid">
        {experimental.map((c) => (
          <a
            class="card link-card"
            href={`/components/${c.category}/${c.id.slice('component.'.length)}`}
            {...cardAttrs(c)}
          >
            <div class="card-body">
              <div class="card-title">{c.name}</div>
              <div class="card-desc">{c.purpose}。</div>
              <StatusBadges maturity={c.maturity} change={c.change} />
            </div>
          </a>
        ))}
      </div>
    ) : (
      <ExceptionState
        kind="empty"
        title="暂无实验组件"
        hint="本期 137 个组件全部按稳定（stable）录入，暂无成熟度为实验的组件；后续批次接入新组件时将在此展示。"
      />
    )
  }
</section>
