---
/**
 * 统一顶部导航：Logo + 四模块入口 + 搜索入口（占位）+ 构建版本。
 * 「文档」为指向现有 docs 文档站的外链（地址收敛为 config.ts 单一常量）；
 * 「主题生成器 / 案例」标记「待设计」，span 渲染、不可导航，不指向不存在的页面。
 */
import { DOCS_SITE_URL } from '../config';
import buildInfo from '../generated/build-info.json';
---

<header class="topbar">
  <button class="btn small mobile-btn" data-drawer-toggle="left" aria-label="打开分类导航">目录</button>
  <a class="brand" href="/styles/overview" style="text-decoration:none;color:inherit">
    <div class="logo" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        width="17"
        height="17"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M12 3.25 20.75 7.75 12 12.25 3.25 7.75Z" fill="currentColor"></path>
        <path
          d="M3.25 11.25 12 15.75 20.75 11.25"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="round"
          stroke-linejoin="round"
          opacity="0.55"
        ></path>
        <path
          d="M3.25 14.75 12 19.25 20.75 14.75"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="round"
          stroke-linejoin="round"
          opacity="0.3"
        ></path>
      </svg>
    </div>
    <span>Pactor</span>
  </a>
  <nav class="topnav">
    <a class="navitem" href={DOCS_SITE_URL} target="_blank" rel="noreferrer">文档</a>
    <a class="navitem active" href="/styles/overview" aria-current="page">资产库</a>
    <span class="navitem pending">主题生成器<span class="pending-dot">待设计</span></span>
    <span class="navitem pending">案例<span class="pending-dot">待设计</span></span>
  </nav>
  <div class="top-actions">
    <button class="search-trigger" type="button" title="全局搜索即将上线" aria-label="搜索（即将上线）">
      <span>⌕</span>
      <span class="label">搜索组件、主题、模板、素材…</span>
      <span class="key">⌘K</span>
    </button>
    <button id="doc-theme-toggle" class="theme-toggle" type="button" aria-label="切换深浅色模式">
    </button>
    <button class="btn small mobile-btn" data-drawer-toggle="right" aria-label="打开页面看板">看板</button>
    <span class="version" title={`构建版本 ${buildInfo.version} · ${buildInfo.commit}`}>build {buildInfo.version}</span>
  </div>
</header>
<script is:inline>
  (function () {
    var btn = document.getElementById('doc-theme-toggle');
    if (!btn) return;
    var MOON =
      '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';
    var SUN =
      '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>';
    function current() {
      return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    }
    function syncIcon() {
      var dark = current() === 'dark';
      btn.innerHTML = dark ? SUN : MOON;
      btn.title = dark ? '切换为浅色' : '切换为深色';
    }
    btn.addEventListener('click', function () {
      var t = current() === 'dark' ? 'light' : 'dark';
      var el = document.documentElement;
      el.dataset.theme = t;
      el.dataset.pactorTheme = t;
      localStorage.setItem('doc-theme', t);
      syncIcon();
    });
    syncIcon();
  })();
</script>
