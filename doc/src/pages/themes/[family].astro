---
/**
 * 色系集合页 /themes/<family>（任务 4.7）：16 个色系各一页。
 * 渲染：色系介绍（数据 description）、色域展示（已接入主题的 baseHex/primary
 * 色块行，待接入主题灰色占位）、5 张主题卡片（已接入可点进详情，待接入
 * 标注「待资产接入」不可点）、跨主题组件对比占位（ExceptionState）。
 */
import AssetLibraryLayout from '../../layouts/AssetLibraryLayout.astro';
import StatusBadges from '../../components/StatusBadges';
import ExceptionState from '../../components/ExceptionState';
import { themes, themeFamilies, themeDefs } from '../../assets-data/themes';
import { SITE_NAV, findSection } from '../../site-nav';
import { toInspectAttrs } from '../../lib/inspect';
import { renderMarkdown } from '../../lib/markdown';
import type { ThemeFamilyId, ThemeModeSupport } from '../../assets-data/types';

interface PathProps {
  familyId: ThemeFamilyId;
}

export function getStaticPaths() {
  const nav = SITE_NAV.find((c) => c.id === 'themes')!;
  return nav.items
    .filter((i) => i.slug !== 'overview')
    .map((item) => ({
      params: { family: item.slug },
      props: { familyId: item.slug as ThemeFamilyId } satisfies PathProps,
    }));
}

const MODE_SUPPORT_LABEL: Record<ThemeModeSupport, string> = {
  'light-only': '仅浅色',
  'light-with-dark-preview': '浅色+深色预览',
  dark: '深色',
  dual: '双模式',
};

const { familyId } = Astro.props as PathProps;
const family = themeFamilies.find((f) => f.id === `family.${familyId}`)!;
const section = findSection('themes', familyId)!;
const currentPath = `/themes/${familyId}`;
const familyThemes = themes.filter((t) => t.familyId === familyId);
const integratedCount = familyThemes.filter(
  (t) => t.integration === 'integrated',
).length;

/** 色域展示：已接入主题取 baseHex（生成色阶的基准传统色），待接入灰色占位 */
const spectrum = familyThemes.map((t) => {
  const def = themeDefs.find((d) => d.id === t.id);
  const hex = t.integration === 'integrated' ? def?.baseHex : undefined;
  return { theme: t, hex };
});

const headings = [
  { id: 'sec-about', text: '色系介绍' },
  { id: 'sec-spectrum', text: '色域展示' },
  { id: 'sec-themes', text: '主题列表' },
  { id: 'sec-compare', text: '跨主题组件对比' },
];

const meta = [
  { label: '规范 ID', value: family.id },
  { label: '分类', value: `主题 / ${section.name}` },
  { label: '主题数', value: `${familyThemes.length}` },
  {
    label: '接入状态',
    value:
      integratedCount === familyThemes.length
        ? '全部接入'
        : `已接入 ${integratedCount} · 待接入 ${familyThemes.length - integratedCount}`,
  },
  { label: '路由', value: currentPath },
];

const guidance = [
  `- 本系共 ${familyThemes.length} 个主题：${familyThemes.map((t) => t.name).join('、')}。`,
  `- 已接入主题（${integratedCount} 个）提供完整色阶与语义映射，可点进详情并复制配置；待接入主题仅有元数据，基准色待设计确认。`,
  '- 主题选择先定色系气质，再按各主题描述的场景（品牌、消费、工具等）与模式支持（浅色 / 深色）细化。',
].join('\n');
---

<AssetLibraryLayout
  title={`${family.name}色系`}
  description={family.description}
  category="themes"
  currentPath={currentPath}
  headings={headings}
  meta={meta}
>
  <div class="breadcrumb">
    资产库 / <a href="/themes/overview">主题</a> / {family.name}
  </div>
  <div class="page-head">
    <div class="page-head-main">
      <h1>{family.name}色系</h1>
      <div class="page-desc">{family.description}</div>
      <StatusBadges client:visible
        maturity={family.maturity}
        change={family.change}
        integration={family.integration}
      />
    </div>
  </div>

  <section class="section" id="sec-about">
    <h2 class="section-title">色系介绍</h2>
    <div class="note-md" set:html={renderMarkdown(guidance)} />
  </section>

  <section class="section" id="sec-spectrum">
    <h2 class="section-title">色域展示</h2>
    <p class="section-sub">
      色块为该主题色阶的基准传统色（baseHex，来源见各主题详情）；待接入主题基准色未确认，以灰色占位标注。
    </p>
    <table class="data-table">
      <thead>
        <tr>
          <th>主题</th>
          <th>色块</th>
          <th>基准色</th>
          <th>接入状态</th>
        </tr>
      </thead>
      <tbody>
        {
          spectrum.map(({ theme, hex }) => (
            <tr
              {...toInspectAttrs({
                id: theme.id,
                name: `${theme.name}主题`,
                type: '色域行',
                maturity: theme.maturity,
                integration: theme.integration,
                props: {
                  基准色: hex ?? '待设计确认',
                  模式支持: MODE_SUPPORT_LABEL[theme.modeSupport],
                },
                description: theme.description,
              })}
            >
              <td>{theme.name}</td>
              <td>
                {hex ? (
                  <span class="swatch-chip" style={`background:${hex}`} />
                ) : (
                  <span class="swatch-chip" style="background:#eceff3;border-style:dashed" />
                )}
              </td>
              <td>
                <code>{hex ?? '待设计确认'}</code>
              </td>
              <td>
                {hex ? (
                  <span class="badge success">已接入</span>
                ) : (
                  <span class="badge warning">待接入</span>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="section" id="sec-themes">
    <h2 class="section-title">主题列表</h2>
    <p class="section-sub">
      共 {familyThemes.length} 个主题（构建期统计）；已接入主题可进入详情，待接入主题标注原因、暂不可进入。
    </p>
    <div class="card-grid">
      {
        familyThemes.map((t) => {
          const body = (
            <div class="card-body">
              <div class="card-title">{t.name}</div>
              <div class="card-desc">{t.description}</div>
              <div class="badges">
                <span class="badge info">
                  {MODE_SUPPORT_LABEL[t.modeSupport]}
                </span>
                {t.traditionalColorRef && (
                  <span class="badge info">传统色：{t.traditionalColorRef}</span>
                )}
              </div>
              <StatusBadges client:visible
                maturity={t.maturity}
                change={t.change}
                integration={t.integration}
              />
              {t.integration === 'pending' && (
                <div class="card-desc">
                  基准色待设计确认，色阶与语义映射待资产接入；本期不可进入详情。
                </div>
              )}
            </div>
          );
          const attrs = toInspectAttrs({
            id: t.id,
            name: `${t.name}主题`,
            type: '主题',
            maturity: t.maturity,
            change: t.change,
            integration: t.integration,
            props: {
              色系: family.name,
              模式支持: MODE_SUPPORT_LABEL[t.modeSupport],
              传统色出处: t.traditionalColorRef ?? '—',
            },
            description: t.description,
          });
          return t.integration === 'integrated' ? (
            <a
              class="card link-card"
              href={`/themes/${familyId}/${t.id.slice(`theme.${familyId}.`.length)}`}
              {...attrs}
            >
              {body}
            </a>
          ) : (
            <div class="card is-disabled" {...attrs}>
              {body}
            </div>
          );
        })
      }
    </div>
  </section>

  <section class="section" id="sec-compare">
    <h2 class="section-title">跨主题组件对比</h2>
    <ExceptionState
      kind="empty"
      title="跨主题组件对比预览待接入"
      hint="同一组件在本系多个主题下的渲染对比依赖组件 Token 映射与主题预览能力，均为后续批次；接入前本区不提供静态截图，以免与真实渲染产生偏差。"
      client:visible
    />
  </section>
</AssetLibraryLayout>
