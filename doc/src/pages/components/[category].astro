---
/**
 * 组件分类集合页 /components/<category>（任务 4.4）：10 个分类各一页。
 * CollectionPage 承载标题说明、筛选（成熟度 / 变更标识 / 接入状态）、
 * 结果数量、卡片网格（跳转详情路由 4.5）与使用规则区。
 * 分类说明与使用规则提炼自 component-design.md §6 各子菜单页面内容（硬编码映射）。
 */
import CollectionPage from '../../templates/CollectionPage.astro';
import { components } from '../../assets-data/components';
import { SITE_NAV, findSection } from '../../site-nav';
import type { ComponentCategoryId } from '../../assets-data/types';

interface PathProps {
  categoryId: ComponentCategoryId;
}

export function getStaticPaths() {
  const nav = SITE_NAV.find((c) => c.id === 'components')!;
  return nav.items
    .filter((i) => i.slug !== 'overview')
    .map((item) => ({
      params: { category: item.slug },
      props: { categoryId: item.slug as ComponentCategoryId } satisfies PathProps,
    }));
}

/** 分类说明（component-design.md §6「页面目标 / 选型重点 / 使用规则」提炼） */
const CATEGORY_INFO: Record<
  ComponentCategoryId,
  { description: string; guidance: string }
> = {
  general: {
    description:
      '构成界面的基础操作、身份与文本表达组件：按钮、图标、排版、链接、分割线、头像、徽标、标签、状态与文字提示。',
    guidance: [
      '- Button 与 Link 的边界：触发即时动作用 Button，页面 / 位置 / 外部跳转用 Link。',
      '- Tag 与 Status 的边界：Tag 标记分类、属性或可移除条件；Status 表达运行、审核或业务状态。',
      '- Badge 表示数量、提醒或附着状态，附着在图标 / 头像右上角，不与 Tag 混用。',
      '- Tooltip 补充短说明或不可见标签；需承载复杂内容时用 Popover。',
    ].join('\n'),
  },
  layout: {
    description:
      '建立页面、区块和组件之间的尺寸与排列关系：栅格、弹性、间距、分割、吸顶、滚动区域与页面框架。',
    guidance: [
      '- Grid 与 Flex：整页 / 区块栅格用 Grid，一维排列与对齐用 Flex。',
      '- Space 表达组件间距时优先引用间距 Token，不写死像素。',
      '- Splitter 与 Resizable：固定分割条用 Splitter，自由调整尺寸用 Resizable。',
      '- 页面滚动与局部 ScrollArea：长页面用窗口滚动，面板内部滚动用 ScrollArea。',
    ].join('\n'),
  },
  navigation: {
    description:
      '帮助用户理解当前位置、可去位置和任务进度：菜单、标签页、面包屑、分页、步骤条、下拉与锚点。',
    guidance: [
      '- Menu 与 Tabs：导航跳转用 Menu，同级内容视图切换用 Tabs。',
      '- Breadcrumb 表达层级位置，BackTop 提供长页面回顶；二者职责不同。',
      '- Steps 表达线性流程进度，配合流程状态展示完成 / 进行 / 失败。',
      '- Pagination 与无限滚动：目标明确、需要定位的列表用 Pagination；浏览型Feed可用无限滚动。',
    ].join('\n'),
  },
  'data-entry': {
    description:
      '选择正确控件，高效、准确地采集和校验数据：输入、数字、选择、级联、日期、上传、开关与完整表单。',
    guidance: [
      '- Select / Combobox / Cascader / TreeSelect：候选少且固定用 Select；候选多可搜索用 Combobox；层级数据用 Cascader / TreeSelect。',
      '- Checkbox / RadioGroup / Switch：多选 Checkbox，单选 RadioGroup，即时启停 Switch。',
      '- DatePicker 与 TimePicker 分开选日期与时间；范围选择使用 Range 变体。',
      '- 校验状态覆盖默认、聚焦、已填、禁用、只读、校验中、警告与错误。',
    ].join('\n'),
  },
  'data-display': {
    description:
      '根据数据结构、规模和用户任务选择展示形式：卡片、列表、表格、树、折叠、描述、时间线与空态骨架。',
    guidance: [
      '- Card / List / Table：单对象用 Card，同构集合用 List 或 Table；高密度编辑与虚拟化用 DataTable。',
      '- Tree 与 Accordion：层级数据用 Tree，内容分组收纳用 Accordion。',
      '- Descriptions 展示单对象字段集，Table 展示集合；二者不互换。',
      '- Empty 与 Skeleton：确定无数据用 Empty，加载中结构占位用 Skeleton。',
    ].join('\n'),
  },
  feedback: {
    description:
      '按反馈重要程度、持续时间和阻断程度选择组件：全局提示、通知、警告、模态、抽屉、气泡确认、进度与结果页。',
    guidance: [
      '- Message / Notification / Alert：操作反馈用 Message（自动消失），系统通知用 Notification，常驻说明用 Alert。',
      '- Dialog / Drawer / Popover：阻断流程的确认或任务用 Dialog；补充大表单 / 详情用 Drawer；轻量上下文内容用 Popover。',
      '- 破坏性操作先经 Popconfirm 或 Dialog 二次确认。',
      '- Spinner 表示紧邻内容的局部处理中；LoadingOverlay 覆盖页面或区块并阻断操作，二者不是可互换的视觉变体。',
    ].join('\n'),
  },
  charts: {
    description:
      '先按表达目标选择图形，再确定数据映射和交互：折线、柱状、饼图、散点、雷达、热力、漏斗、仪表盘与地图。',
    guidance: [
      '- 趋势用折线 / 面积，比较用柱状 / 条形，构成用饼图 / 环形，分布用散点 / 气泡，占比变化用堆叠。',
      '- 树图 / 桑基表达层级与流向关系；地图表达地理分布。',
      '- 明确维度、度量、坐标轴、图例、颜色、标签、提示和数据更新时间。',
      '- 状态覆盖加载、无数据、部分缺失、异常值、数据过密、实时更新与查询失败。',
    ].join('\n'),
  },
  media: {
    description:
      '安全、清晰地查看图片、音视频、文档、代码和结构化文本：图片、画廊、文件预览、富文本、Markdown 与代码查看器。',
    guidance: [
      '- Image 负责基础图片展示；放大、缩放与切换查看用 ImageViewer。',
      '- FilePreview / DocumentPreview 预览附件与文档；格式不支持与权限不足需给出明确状态。',
      '- RichText / Markdown 展示富文本与结构化文本；代码场景用 CodeBlock / DiffViewer / JSONViewer。',
      '- 媒体内容加载、失效、播放失败均需提供重试或占位。',
    ].join('\n'),
  },
  'ai-chat': {
    description:
      '构建连续对话、生成过程、来源引用和工具执行体验：会话消息、气泡、消息列表、会话列表、输入区、提示词入口与 Agent 状态。',
    guidance: [
      '- Bubble / ChatMessage：ChatMessage 是会话内消息资产，与反馈分类全局 Message 严格区分。',
      '- MessageList 展示单会话消息序列，ConversationList 管理多会话入口。',
      '- Prompt 组件是会话内的任务提交入口；素材库「生成提示词」是内容资产，二者经提示词资产 ID 关联，不复制模型参数。',
      '- 状态覆盖等待、流式生成、暂停、停止、失败、重试、编辑重发、工具执行与引用失效。',
    ].join('\n'),
  },
  business: {
    description:
      '由多个基础组件组成、可跨业务复用的复合任务单元：实体摘要卡（EntityCard / CardList）、登录页（Login）、站点页脚（SiteFooter）与规则配置类编辑器（ExpressionEditor / FieldCondition / RuleConfig / RuleExpression / ScriptEditor / SearchableSelect）。',
    guidance: [
      '- 优先评估用基础组件组合实现；组合成本高于复用收益时再引入业务组件。',
      '- 业务组件内部子任务需处理加载、局部失败、权限不足、未保存、冲突与大数据量状态。',
      '- 典型组合：CardList + EntityCard（实体列表）、Login + SiteFooter（整页收尾）、ExpressionEditor + FieldCondition（表达式与条件编辑）。',
      '- 引入业务组件需接受其依赖成本（数据服务、权限模型），详情页将逐项说明适用边界。',
    ].join('\n'),
  },
};

const { categoryId } = Astro.props as PathProps;
const item = findSection('components', categoryId)!;
const info = CATEGORY_INFO[categoryId];
const items = components
  .filter((c) => c.category === categoryId)
  .map((c) => ({
    id: c.id,
    name: c.name,
    description: `${c.purpose}。`,
    href: `/components/${c.category}/${c.id.slice('component.'.length)}`,
    maturity: c.maturity,
    change: c.change,
    integration: c.integration,
    filters: {
      maturity: c.maturity,
      change: c.change ?? 'none',
      integration: c.integration,
    },
  }));
---

<CollectionPage
  title={`${item.name}组件`}
  description={info.description}
  category="components"
  currentPath={`/components/${categoryId}`}
  filters={[
    {
      key: 'maturity',
      label: '成熟度',
      options: [
        { value: 'stable', label: '稳定' },
        { value: 'experimental', label: '实验' },
        { value: 'deprecated', label: '废弃' },
      ],
    },
    {
      key: 'change',
      label: '变更标识',
      options: [
        { value: 'new', label: '本期新增' },
        { value: 'updated', label: '本期更新' },
        { value: 'none', label: '无变更' },
      ],
    },
    {
      key: 'integration',
      label: '接入状态',
      options: [
        { value: 'integrated', label: '已接入' },
        { value: 'pending', label: '待资产接入' },
      ],
    },
  ]}
  items={items}
  guidance={info.guidance}
/>
