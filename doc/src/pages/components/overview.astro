---
/**
 * 组件总览页 /components/overview（任务 4.3）。
 * CategoryOverview 承载分类介绍、10 个分类入口（计数构建期统计）与使用指引；
 * 覆盖矩阵 / 常用组件 / 最近更新 / 实验区为自定义区（ComponentsOverviewSections）。
 */
import CategoryOverview from '../../templates/CategoryOverview.astro';
import ComponentsOverviewSections from '../../components/ComponentsOverviewSections.astro';
import { components } from '../../assets-data/components';
import { SITE_NAV } from '../../site-nav';

const category = SITE_NAV.find((c) => c.id === 'components')!;
const total = components.length;
const experimentalCount = components.filter(
  (c) => c.maturity === 'experimental',
).length;

const intro = [
  `组件资产按 10 个二级分类组织，合计 ${total} 个组件（首版验收清单，构建期统计）。`,
  '每个组件以规范 ID（`component.<name>`）为唯一引用键，卡片标注成熟度与变更标识；点击分类入口进入集合页，可继续进入组件详情。',
  `本期 ${experimentalCount > 0 ? `${experimentalCount} 个组件处于实验态` : '组件全部按稳定录入，实验区为空'}；组件运行态预览与 Design Token 映射随后续批次接入，详情页相关章节如实标注「不适用」。`,
].join('\n\n');

const guidance = [
  '**从任务定位组件**：先按「页面骨架 → 区块 → 交互」缩小到二级分类（如「采集与校验数据」→ 数据录入），再在分类内按选型重点比较相似组件。',
  '',
  '- 触发动作还是跳转页面：动作选 Button，跳转选 Link / 导航。',
  '- 全局反馈还是会话消息：反馈分类 Message / Notification 对应全局；ChatMessage 只用于会话内。',
  '- 表格三层级：Table（常规只读 / 轻操作）→ DataGrid（高密度编辑与虚拟化）→ 高级表格（查询、列配置与批量任务）。',
  '- Spin 表示紧邻内容的局部处理中；LoadingOverlay 覆盖页面或区块并阻断操作，二者不可互换。',
  '',
  '**成熟度含义**：稳定 = 可生产使用；实验 = 接口或视觉可能调整，使用需评估；废弃 = 保留入口并给出替代项。',
  '变更标识（本期新增 / 本期更新）表示本构建批次的变化，与成熟度相互独立。',
].join('\n');
---

<CategoryOverview
  category={category}
  intro={intro}
  guidance={guidance}
  relatedCategories={['styles', 'themes', 'templates']}
  extraSections={ComponentsOverviewSections}
  extraHeadings={[
    { id: 'sec-matrix', text: '覆盖矩阵' },
    { id: 'sec-common', text: '常用组件' },
    { id: 'sec-recent', text: '最近更新' },
    { id: 'sec-experimental', text: '实验区' },
  ]}
/>
