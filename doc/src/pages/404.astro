---
/**
 * 404 兜底页：无效路由统一入口。
 * wrangler.jsonc 使用 not_found_handling=404-page，部署校验要求
 * 产物目录存在 /404.html，故单独成页；复用三栏布局壳保持一致。
 */
import AssetLibraryLayout from '../layouts/AssetLibraryLayout.astro';

const currentPath = '/404';
---

<AssetLibraryLayout
  title="页面不存在"
  description="访问的地址不存在或已被移动。"
  category="styles"
  currentPath={currentPath}
  meta={[{ label: '路由', value: currentPath }]}
>
  <div class="breadcrumb">资产库 / 404</div>
  <div class="page-head">
    <div class="page-head-main">
      <h1>404 · 页面不存在</h1>
      <div class="page-desc">访问的地址不存在或已被移动。</div>
    </div>
  </div>
  <section class="section">
    <h2 class="section-title">可以从这里继续</h2>
    <div class="note-md">
      <p>
        回到 <a href="/styles/overview">样式总览</a> · <a href="/components/overview">组件总览</a> ·
        <a href="/themes/overview">主题总览</a> · <a href="/templates/overview">模板总览</a> ·
        <a href="/materials/overview">素材总览</a>
      </p>
    </div>
  </section>
</AssetLibraryLayout>
