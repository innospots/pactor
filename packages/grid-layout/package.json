{
  "name": "@pactor-app/grid-layout",
  "version": "1.65.0",
  "description": "Pactor grid layout: react-grid-layout-backed DSL draggable/resizable dashboard container (GridLayout) with component registry for the Renderer",
  "keywords": [
    "pactor",
    "dsl",
    "server-driven-ui",
    "grid-layout",
    "dashboard",
    "drag",
    "resize",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/innospots/pactor.git",
    "directory": "packages/grid-layout"
  },
  "homepage": "https://github.com/innospots/pactor/tree/main/packages/grid-layout",
  "bugs": {
    "url": "https://github.com/innospots/pactor/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./styles.css"
  },
  "sideEffects": [
    "./styles.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsup && pnpm build:styles",
    "build:styles": "node scripts/build-styles.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pactor-app/core": "workspace:*",
    "@pactor-app/runtime": "workspace:*",
    "react-grid-layout": "^2.3.0",
    "react-resizable": "^3.2.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vitest": "^3.2.4"
  }
}
