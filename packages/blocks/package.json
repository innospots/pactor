{
  "name": "@pactor-app/blocks",
  "version": "1.50.0",
  "description": "Pactor blocks: composite block components built from @pactor-app/ui primitives (Login / EntityCard / CardList / RecordingPage / SiteFooter / rule & expression editors) with block component registry for the Renderer",
  "keywords": [
    "pactor",
    "dsl",
    "server-driven-ui",
    "blocks",
    "composite",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/426-330/pactor.git",
    "directory": "packages/blocks"
  },
  "homepage": "https://github.com/426-330/pactor/tree/main/packages/blocks",
  "bugs": "https://github.com/426-330/pactor/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./styles.css"
  },
  "sideEffects": [
    "./styles.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsup && pnpm build:styles",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "build:styles": "tailwindcss -i src/styles.css -o styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pactor-app/core": "workspace:*",
    "@pactor-app/runtime": "workspace:*",
    "@pactor-app/ui": "workspace:*",
    "ace-builds": "^1.44.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vitest": "^3.2.4",
    "@testing-library/user-event": "^14.6.2",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
