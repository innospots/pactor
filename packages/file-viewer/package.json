{
  "name": "@pactor-app/file-viewer",
  "version": "1.62.0",
  "description": "Pactor file viewer: @file-viewer/react-backed DSL file preview component (PDF / Office / …) with component registry for the Renderer",
  "keywords": [
    "pactor",
    "dsl",
    "server-driven-ui",
    "file-viewer",
    "preview",
    "office",
    "pdf",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/innospots/pactor.git",
    "directory": "packages/file-viewer"
  },
  "homepage": "https://github.com/innospots/pactor/tree/main/packages/file-viewer",
  "bugs": {
    "url": "https://github.com/innospots/pactor/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@file-viewer/react": "^3.3.3",
    "@pactor-app/core": "workspace:*",
    "@pactor-app/runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vitest": "^3.2.4"
  }
}
