{
  "name": "@pactor/chat",
  "version": "0.1.0",
  "description": "Pactor chat: AI message rendering protocol (message model, streaming reducer, safe registry, capability action) and chat runtime view (ChatView / MessageBubble / PartRenderer / Composer / chat layout)",
  "keywords": [
    "pactor",
    "dsl",
    "server-driven-ui",
    "chat",
    "ai",
    "llm",
    "streaming",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/426-330/pactor.git",
    "directory": "packages/chat"
  },
  "homepage": "https://github.com/426-330/pactor/tree/main/packages/chat",
  "bugs": "https://github.com/426-330/pactor/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./styles.css"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "@pactor/core": "workspace:*",
    "@pactor/markdown": "workspace:*",
    "@pactor/permission": "workspace:*",
    "@pactor/runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "@pactor/ui": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
