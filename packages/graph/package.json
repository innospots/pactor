{
  "name": "@pactor-app/graph",
  "version": "1.66.0",
  "description": "Pactor graph: AntV G6-backed DSL relation/flow graph component (Graph) with component registry for the Renderer",
  "keywords": [
    "pactor",
    "dsl",
    "server-driven-ui",
    "graph",
    "relation-graph",
    "flow",
    "g6",
    "antv",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/innospots/pactor.git",
    "directory": "packages/graph"
  },
  "homepage": "https://github.com/innospots/pactor/tree/main/packages/graph",
  "bugs": {
    "url": "https://github.com/innospots/pactor/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@antv/g6": "^5.1.1",
    "@pactor-app/core": "workspace:*",
    "@pactor-app/runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vitest": "^3.2.4"
  }
}
