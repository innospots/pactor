{
  "name": "@pactor-app/vite-plugin",
  "version": "1.20.0",
  "description": "Pactor Vite plugin: import .page.yaml / .fragment.yaml DSL files as JS modules with build-time validation and HMR",
  "keywords": [
    "pactor",
    "dsl",
    "server-driven-ui",
    "vite",
    "vite-plugin",
    "yaml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/426-330/pactor.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "https://github.com/426-330/pactor/tree/main/packages/vite-plugin",
  "bugs": "https://github.com/426-330/pactor/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pactor-app/core": "workspace:*",
    "@pactor-app/schema": "workspace:*",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "vite": "^8.2.1"
  }
}
