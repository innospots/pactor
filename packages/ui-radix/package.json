{
  "name": "pactor-ui-radix",
  "version": "0.1.0",
  "description": "Pactor UI kit (Radix): builtin components + interaction (overlay) + layouts implementing the pactor-ui-antd contracts without antd, with the radixUiKit preset object and a merged stylesheet",
  "keywords": [
    "pactor",
    "dsl",
    "server-driven-ui",
    "ui-kit",
    "radix-ui",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/426-330/pactor.git",
    "directory": "packages/ui-radix"
  },
  "homepage": "https://github.com/426-330/pactor/tree/main/packages/ui-radix",
  "bugs": "https://github.com/426-330/pactor/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./components": {
      "import": {
        "types": "./dist/components/index.d.ts",
        "default": "./dist/components/index.js"
      },
      "require": {
        "types": "./dist/components/index.d.cts",
        "default": "./dist/components/index.cjs"
      }
    },
    "./interaction": {
      "import": {
        "types": "./dist/interaction/index.d.ts",
        "default": "./dist/interaction/index.js"
      },
      "require": {
        "types": "./dist/interaction/index.d.cts",
        "default": "./dist/interaction/index.cjs"
      }
    },
    "./layout": {
      "import": {
        "types": "./dist/layout/index.d.ts",
        "default": "./dist/layout/index.js"
      },
      "require": {
        "types": "./dist/layout/index.d.cts",
        "default": "./dist/layout/index.cjs"
      }
    },
    "./styles.css": "./styles.css"
  },
  "sideEffects": [
    "./styles.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-form": "^0.1.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "pactor-core": "workspace:*",
    "pactor-permission": "workspace:*",
    "pactor-router": "workspace:*",
    "pactor-runtime": "workspace:*",
    "pactor-ui-antd": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "antd": "^6.6.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
