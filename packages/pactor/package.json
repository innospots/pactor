{
  "name": "pactor-app",
  "version": "1.35.0",
  "description": "Pactor meta package: installs the full Server-Driven UI + AI-Native runtime stack (@pactor-app/*) and re-exports the one-stop application API (createPactorApplication)",
  "keywords": [
    "pactor",
    "dsl",
    "server-driven-ui",
    "dynamic-ui",
    "ai-native",
    "runtime",
    "react"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/426-330/pactor.git",
    "directory": "packages/pactor"
  },
  "homepage": "https://github.com/426-330/pactor/tree/main/packages/pactor",
  "bugs": "https://github.com/426-330/pactor/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pactor-app/app": "1.34.0",
    "@pactor-app/chat": "1.34.0",
    "@pactor-app/cli": "1.34.0",
    "@pactor-app/core": "1.34.0",
    "@pactor-app/expression": "1.34.0",
    "@pactor-app/markdown": "1.34.0",
    "@pactor-app/permission": "1.34.0",
    "@pactor-app/resource": "1.34.0",
    "@pactor-app/router": "1.34.0",
    "@pactor-app/runtime": "1.34.0",
    "@pactor-app/schema": "1.34.0",
    "@pactor-app/ui": "1.34.0",
    "@pactor-app/vite-plugin": "1.34.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": ">=6"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  }
}
