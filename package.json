{
  "name": "pactor-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Pactor — Dynamic Application Runtime: Server-Driven UI + AI-Native frontend runtime framework",
  "keywords": [
    "pactor",
    "dsl",
    "server-driven-ui",
    "dynamic-ui",
    "ai-native",
    "runtime"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/innospots/pactor.git"
  },
  "homepage": "https://github.com/innospots/pactor",
  "bugs": "https://github.com/innospots/pactor/issues",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test && vitest run tests/",
    "typecheck": "pnpm -r --if-present typecheck",
    "docs:dev": "pnpm --filter pactor-docs dev",
    "docs:build": "pnpm --filter pactor-docs build",
    "docs:preview": "pnpm --filter pactor-docs preview",
    "release": "pnpm -r --filter \"./packages/*\" --filter \"./skills\" --if-present build && pnpm -r --filter \"./packages/*\" --filter \"./skills\" --if-present test && vitest run tests/ && pnpm -r --filter \"./packages/*\" --filter \"./skills\" publish"
  },
  "devDependencies": {
    "@pactor-app/core": "workspace:*",
    "@pactor-app/expression": "workspace:*",
    "@pactor-app/schema": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
